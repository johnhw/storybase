
# test04_control_flow.sb
#
# Control flow: match, cond, for, while, let, lambda expressions.
#
# Tests:
#   - match as statement and as expression
#   - cond with multiple boolean branches and wildcard
#   - for loop over a path-list family
#   - while loop inside a transaction function (condition mutated by body)
#   - let bindings (sequential via nested let; each can reference the previous)
#   - Lambda expressions passed to any?, all?, count-where
#   - Computed goto using match
#
# Expected behaviour:
#   "Resolve combat" runs the while loop until combat ends (max 10 rounds).
#   "Check party" uses for + lambda to count and display living members.
#   cond produces the correct danger label at each health threshold.

module test-control-flow
  version: 1.0

schema-version: 1

engine-config:
  entry-scene: overview

# ── Types ──────────────────────────────────────────────────────────────────

type Status      = alive | dead
type CharClass   = warrior | rogue | mage
type DangerLevel = safe | caution | danger | critical
type Phase       = setup | combat | rest

type Health = Int(0, 100)
type Damage = Int(0, 40)

type Member:
  health: Health = 60
  status: Status = `alive
  class:  CharClass = `warrior

# ── State ──────────────────────────────────────────────────────────────────

state player:
  health:  Health = 100
  status:  Status = `alive
  class:   CharClass = `warrior
  round:   Int(0, 99) = 0

state party/{member}: Member  max: 4

state world:
  phase:       Phase = `setup
  enemy-hp:    Health = 80
  rounds-done: Int(0, 99) = 0

# ── Pure functions ─────────────────────────────────────────────────────────

fn danger-level:
  # cond as expression — each branch is a return value
  cond:
    player/health <= 10:  `critical
    player/health <= 30:  `danger
    player/health <= 60:  `caution
    _:                    `safe

fn living-count:
  # count-where with a lambda over the party family
  count-where (path-list party)  fn(m): party/{m}/status = `alive

fn any-alive?:
  # any? with a lambda
  any? (path-list party)  fn(m): party/{m}/status = `alive

fn all-dead?:
  # all? with a lambda
  all? (path-list party)  fn(m): party/{m}/status = `dead

fn warrior-damage:
  match player/class:
    `warrior: 18
    `rogue:   12
    `mage:     7

# ── Transaction functions ───────────────────────────────────────────────────

fn spawn-party:
  spawn! party `fighter  Member(class: `warrior, health: 80)
  spawn! party `scout    Member(class: `rogue,   health: 60)
  spawn! party `wizard   Member(class: `mage,    health: 50)
  set!   world/phase `combat

fn resolve-combat:
  pre:  world/phase = `combat
  pre:  world/enemy-hp > 0
  # while loop: runs until enemy or player dies, or 10 rounds maximum
  while world/enemy-hp > 0  and  player/status = `alive  and  world/rounds-done < 10:
    let dmg-to-enemy = warrior-damage:
      let dmg-to-player = (random-int 5 15):
        dec! world/enemy-hp    dmg-to-enemy
        dec! player/health     dmg-to-player
        inc! world/rounds-done 1
        when player/health <= 0:
          set! player/status `dead
  when world/enemy-hp <= 0:
    set! world/phase `rest

fn rest-party:
  pre:  world/phase = `rest
  # for loop over party members — heal all living members
  for m in (path-list party):
    when party/{m}/status = `alive:
      inc! party/{m}/health 20
  set! world/phase `setup

fn apply-class-bonus:
  # nested let demonstrating sequential binding (each let can reference outer)
  let base = warrior-damage:
    let scaled = base * 2:
      let capped = min scaled 35:
        set! world/enemy-hp (max 0 (world/enemy-hp - capped))

# ── Scenes ─────────────────────────────────────────────────────────────────

scene overview:
  Phase: {world/phase}.  Your health: {player/health} ({danger-level}).
  Living party members: {living-count}.  Enemy HP: {world/enemy-hp}.

  -> (match world/phase:
        `setup:  `setup-scene
        `combat: `combat-scene
        `rest:   `rest-scene)

scene setup-scene:
  The adventuring party assembles.

  * [not (any-alive?)] Spawn the party
    spawn-party
    -> overview

  * [any-alive?] Party already assembled — proceed
    set! world/phase `combat
    -> overview

scene combat-scene:
  The enemy looms before you. Enemy HP: {world/enemy-hp}.

  * Fight until resolved
    resolve-combat
    -> overview

  * Use class ability (deal double damage, capped at 35)
    apply-class-bonus
    -> overview

scene rest-scene:
  The battle is over. The party rests.

  * Rest and recover
    rest-party
    -> overview
