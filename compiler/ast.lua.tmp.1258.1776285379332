--- params is list of {name, type_expr} tables
function M.fn_decl(name, params, pre, post, tags, body, doc, pos)
  return M.node(M.K.FN_DECL, {
    name = name, params = params or {},
    pre = pre or {}, post = post or {},
    tags = tags or {}, body = body or {},
    doc = doc,
  }, pos)
