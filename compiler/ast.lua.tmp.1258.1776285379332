-- ============================================================
-- Diagnostic accumulator
-- ============================================================

--- Create a new diagnostic accumulator.
--- The returned table tracks errors and warnings separately and provides
--- helper methods for pushing, merging, and testing diagnostics.
function M.new_accum()
  local acc = { errors = {}, warnings = {}, all = {} }

  --- Push a single diagnostic.
  function acc:push(diag)
    table.insert(self.all, diag)
    if diag.level == "error" then
      table.insert(self.errors, diag)
    else
      table.insert(self.warnings, diag)
    end
  end

  --- Push all diagnostics from a list.
  function acc:push_all(diags)
    for _, d in ipairs(diags or {}) do
      self:push(d)
    end
  end

  --- Merge another accumulator into this one.
  function acc:merge(other)
    self:push_all(other and other.all or {})
  end

  --- Return true if any errors have been accumulated.
  function acc:has_errors()
    return #self.errors > 0
  end

  --- Convenience: push an error diagnostic.
  function acc:push_error(code, message, pos, note)
    self:push(M.error(code, message, pos, note))
  end

  --- Convenience: push a warning diagnostic.
  function acc:push_warning(code, message, pos, note)
    self:push(M.warning(code, message, pos, note))
  end

  return acc
end

return M
