--- initial_data is list of {key, values} pairs for static data block
function M.relation_decl(name, from_type, to_type_expr, initial_data, doc, pos)
  return M.node(M.K.RELATION_DECL, {
    name = name, from_type = from_type,
    to_type_expr = to_type_expr,
    initial_data = initial_data or {},
