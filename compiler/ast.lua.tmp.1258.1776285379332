-- ============================================================
-- Predicates
-- ============================================================

--- Return true if node is a top-level declaration.
function M.is_decl(node)
  return node ~= nil and DECL_KINDS[node.kind] == true
end

--- Return true if node is a mutation primitive.
function M.is_mut(node)
  return node ~= nil and MUT_KINDS[node.kind] == true
end

--- Return true if node is a type expression.
function M.is_type_expr(node)
  return node ~= nil and TYPE_EXPR_KINDS[node.kind] == true
end

-- ============================================================
-- Base node constructor
-- ============================================================

--- Construct an AST node.
---@param kind   string  One of M.K.*
---@param fields table   Node-specific fields
---@param pos    table?  Source position {file, line, col}
---@return table
function M.node(kind, fields, pos)
  local n = { kind = kind, pos = pos or NO_POS }
  for k, v in pairs(fields or {}) do
    n[k] = v
  end
  return n
end

-- ============================================================
-- Specific node constructors
-- ============================================================

-- Program root
function M.program(decls, pos)
  return M.node(M.K.PROGRAM, { decls = decls or {} }, pos)
end

-- ── Declarations ─────────────────────────────────────────────

function M.module_decl(name, version, exports, pos)
  return M.node(M.K.MODULE_DECL, { name = name, version = version, exports = exports }, pos)
end

--- flat import (alias=nil) or namespaced import (alias=string)
function M.import_decl(path, alias, pos)
  return M.node(M.K.IMPORT_DECL, { path = path, alias = alias }, pos)
end

function M.schema_version(version, pos)
  return M.node(M.K.SCHEMA_VERSION, { version = version }, pos)
end

--- keys is a table of {key, value} pairs for engine-config options
function M.engine_config(keys, pos)
  return M.node(M.K.ENGINE_CONFIG, { keys = keys or {} }, pos)
end

--- axes is list of axis name strings; wrap is list of wrap settings
function M.time_model(axes, wrap, pos)
  return M.node(M.K.TIME_MODEL, { axes = axes or {}, wrap = wrap or {} }, pos)
end

--- values is list of strings (enum member names)
function M.type_enum(name, values, doc, pos)
  return M.node(M.K.TYPE_ENUM, { name = name, values = values or {}, doc = doc }, pos)
end

--- type_expr is a type expression node (e.g. type_int, type_named)
function M.type_alias(name, type_expr, doc, pos)
  return M.node(M.K.TYPE_ALIAS, { name = name, type_expr = type_expr, doc = doc }, pos)
end

--- fields is list of record_field or with_mixin nodes
function M.type_record(name, fields, doc, pos)
  return M.node(M.K.TYPE_RECORD, { name = name, fields = fields or {}, doc = doc }, pos)
end

--- branches is list of variant_branch nodes
function M.type_variant(name, branches, doc, pos)
  return M.node(M.K.TYPE_VARIANT, { name = name, branches = branches or {}, doc = doc }, pos)
end

function M.record_field(name, type_expr, default, doc, pos)
  return M.node(M.K.RECORD_FIELD,
    { name = name, type_expr = type_expr, default = default, doc = doc }, pos)
end

function M.with_mixin(type_name, pos)
  return M.node(M.K.WITH_MIXIN, { type_name = type_name }, pos)
end

function M.variant_branch(name, fields, pos)
  return M.node(M.K.VARIANT_BRANCH, { name = name, fields = fields or {} }, pos)
end

function M.state_scalar(path, type_expr, default, doc, pos)
  return M.node(M.K.STATE_SCALAR,
    { path = path, type_expr = type_expr, default = default, doc = doc }, pos)
end

function M.state_record(path, fields, doc, pos)
  return M.node(M.K.STATE_RECORD, { path = path, fields = fields or {}, doc = doc }, pos)
