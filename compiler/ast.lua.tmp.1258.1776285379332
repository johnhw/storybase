-- compiler/ast.lua
-- AST node constructors, kind constants, predicates, and diagnostic constructors.
--
-- Every AST node is a plain Lua table with at minimum:
--   { kind = K.SOME_KIND, pos = {file="...", line=N, col=N} }
-- Additional fields vary by kind and are documented below.
--
-- The diagnostic accumulator (M.new_accum) is also defined here so every
-- compiler pass can produce errors and warnings without a separate import.

local M = {}

-- ============================================================
-- Source position
-- ============================================================

--- Construct a source position table.
---@param file string
---@param line integer
---@param col  integer
---@return table
function M.pos(file, line, col)
  return { file = file, line = line or 0, col = col or 0 }
end

local NO_POS = M.pos("?", 0, 0)

-- ============================================================
-- Diagnostic constructors
-- ============================================================
-- All diagnostics follow this structure:
--   @field code    string   UPPER_SNAKE error/warning code
--   @field message string   Human-readable description
--   @field file    string   Source file name
--   @field line    integer  1-based line number
--   @field col     integer  1-based column number
--   @field note    string?  Optional additional context
--   @field level   string   "error" or "warning"

local function _diag(level, code, message, pos, note)
  pos = pos or NO_POS
  return {
    level   = level,
    code    = code,
    message = message,
    file    = pos.file,
    line    = pos.line,
    col     = pos.col,
    note    = note,
  }
end

--- Construct an error diagnostic.
function M.error(code, message, pos, note)
  return _diag("error", code, message, pos, note)
end

--- Construct a warning diagnostic.
function M.warning(code, message, pos, note)
  return _diag("warning", code, message, pos, note)
end

