module demo35-healers-ward-ui
  version: 1.0

# Demo 35 — The Healer's Ward (UI-bound variant)
#
# Built on top of demo13 (the healer's ward). The gameplay is the same;
# what this demo adds is the §M4–§M8 author-declared `ui:` bindings so a
# driver — curses, plain text, or any future GUI — can render the live
# ward HUD without the author writing a single line of layout code.
#
# Demonstrates:
#   • ui: block on a state scalar (stat-bar, stat, toggle, choice)
#   • ui: block on a state holding a List (inventory widget)
#   • ui-panel decl composing widget references + an interpolated text line
#   • engine-config: ui-runtime: true so the bindings stick under bundle
#     --production
#
# Widget vocabulary touched: stat-bar, stat, toggle, choice, inventory,
# text (via ui-panel children). The curses driver renders all six; the
# plain driver collapses stat-bar / stat / toggle / inventory / text to
# one header line each (choice is curses-only).
#
# Run with:
#   lua5.4 cli/main.lua run demos/demo35_healers_ward_ui.sb
#       --ui curses
#   lua5.4 cli/main.lua run demos/demo35_healers_ward_ui.sb
#       --ui plain --auto --steps 6
#   lua5.4 cli/main.lua run demos/demo35_healers_ward_ui.sb
#       --ui curses --ui-backend buffer --ui-keys "1111" --ui-snapshot /tmp/hud.txt

# ── Engine config ────────────────────────────────────────────────────────────

engine-config:
  entry-scene: start
  ui-runtime: true

# ── Speakers ─────────────────────────────────────────────────────────────────

speaker healer:
  display: "Healer"
  color:   "#a8d8a8"

speaker elara:
  display: "Elara (Nurse)"
  color:   "#f0c080"

speaker rook:
  display: "Rook"
  color:   "#c08080"

speaker linden:
  display: "Linden"
  color:   "#80a8c0"

speaker mira:
  display: "Mira"
  color:   "#c080c0"

# ── Types ────────────────────────────────────────────────────────────────────

type Condition = wounded | feverish | recovering | stable | discharged

# A small enum the UI exposes via the `choice` widget so the healer can
# pick which patient class to triage first. The enum is also read by
# scene preconditions and by `select-triaged` below — declarative UI
# binding, declarative game logic.
type TriageFocus = urgent | dischargeable | any

type Patient:
  name:      String
  condition: Condition
  health:    Int(0, 100)
  speaker:   Symbol
  treated:   Bool = false

# ── State ────────────────────────────────────────────────────────────────────
#
# Each `state ... ui:` block is *presentation only*. The engine never
# reads it; drivers walk `schema.states[*].ui` and render accordingly.

state world/herbs: Int(0, 20) = 12
  ui:
    kind:       stat-bar
    label:      "Herbs"
    color-good: "#4ade80"
    color-bad:  "#ef4444"

state world/bandages: Int(0, 20) = 8
  ui:
    kind:       stat-bar
    label:      "Bandages"
    color-good: "#4ade80"
    color-bad:  "#ef4444"

state world/day: Int(1, 7) = 1
  ui:
    kind:  stat
    label: "Day"

# The triage focus the healer is currently prioritising. Choice widget
# in curses; flattens to "Focus: urgent" / "Focus: dischargeable" /
# "Focus: any" in plain.
state world/triage-focus: TriageFocus = `any
  ui:
    kind:  choice
    label: "Triage focus"

# A simple toggle the player flips to opt into resting automatically
# when no patients need attention. Wired to the `set-auto-rest` fn so
# space/Enter on the curses toggle widget round-trips through the
# engine.
state world/auto-rest: Bool = false
  ui:
    kind:    toggle
    label:   "Auto-rest"
    fn:      set-auto-rest

# A short, append-only journal of recent events. Inventory widget in
# curses (scrollable bulleted list); plain prints "Journal: a, b, c".
state world/journal: UList(String) = ["Ward opens."]
  ui:
    kind:     inventory
    label:    "Journal"
    max-rows: 5

# Patient family — no ui binding (the inventory widget today binds to
# scalar list paths, not to families). The HUD's text widget references
# individual patient fields by interpolated path; that flows through the
# same kernel state cache.
state patients/{k}: Patient max: 8

state world/selected-patient: Symbol = `rook

# ── HUD composition ─────────────────────────────────────────────────────────
#
# ui-panel decls compose widget references and free text. Drivers
# discover panels via `kernel:get_bindings()` and lay them out (curses
# stacks them in a top strip; plain prints one line each).

"The ward HUD: supplies, day counter, triage focus, and a journal."
ui-panel ward-hud:
  layout:   vstack
  position: top
  children:
    - stat-bar world/herbs
    - stat-bar world/bandages
    - stat     world/day
    - text     "Tending: {world/selected-patient} (day {world/day})"
    - choice   world/triage-focus
    - toggle   world/auto-rest
    - inventory world/journal

# ── Initialisation ───────────────────────────────────────────────────────────

fn init-ward:
  pre: not (path-exists? patients/rook/health)
  spawn! patients `rook    Patient(name: "Rook",   condition: `wounded,  health: 35, speaker: `rook)
  spawn! patients `linden  Patient(name: "Linden", condition: `feverish, health: 45, speaker: `linden)
  spawn! patients `mira    Patient(name: "Mira",   condition: `stable,   health: 70, speaker: `mira)

# ── Journal helpers ──────────────────────────────────────────────────────────

# A tiny helper so every state-changing fn can drop a line into the
# inventory widget without repeating list mechanics. When the journal
# grows past eight entries we pop the oldest before pushing so the HUD
# strip stays small.
fn record-event entry:
  when ulist-size world/journal >= 8:
    pop! world/journal
  push! world/journal entry

# ── Toggle target ────────────────────────────────────────────────────────────

# Called from the curses toggle widget on space/Enter. The widget passes
# the *new* boolean as the single argument so the fn is symmetric across
# both directions.
fn set-auto-rest v:
  set! world/auto-rest v
  if v:
    record-event "Auto-rest enabled."
  else:
    record-event "Auto-rest disabled."

# ── Query helpers (mostly unchanged from demo13) ──────────────────────────────

fn find-urgent:
  return find patients where: fn(k):
    let low-health = patients/{k}/health < 50
    let untreated  = not patients/{k}/treated
    return low-health and untreated

fn find-dischargeable:
  return find patients where: fn(k):
    let good-cond = patients/{k}/condition = `recovering or patients/{k}/condition = `stable
    return good-cond and not patients/{k}/treated

fn count-untreated:
  return count patients where: fn(k): not patients/{k}/treated

fn any-urgent?:
  return any? (path-list patients) fn(k):
    patients/{k}/health < 50 and not patients/{k}/treated

fn any-dischargeable?:
  return any? (path-list patients) fn(k):
    let good = patients/{k}/condition = `recovering or patients/{k}/condition = `stable
    return good and not patients/{k}/treated

fn all-treated?:
  return all? (path-list patients) fn(k): patients/{k}/treated or patients/{k}/condition = `discharged

# ── Selection driven by triage focus ─────────────────────────────────────────

fn select-by-focus:
  let chosen = match world/triage-focus:
    `urgent:        find-urgent
    `dischargeable: find-dischargeable
    `any:           (find patients where: fn(k): not patients/{k}/treated)
    _:              find-urgent
  let key = list-get chosen 1 ?? `rook
  set! world/selected-patient key

# ── Treatment functions ──────────────────────────────────────────────────────

fn apply-bandage key:
  pre:
    world/bandages > 0
    patients/{key}/condition = `wounded
  post:
    world/bandages = world/bandages@before - 1
    patients/{key}/health >= patients/{key}/health@before
  dec! world/bandages 1
  inc! patients/{key}/health 25
  set! patients/{key}/treated true
  when patients/{key}/health >= 75:
    set! patients/{key}/condition `recovering
  record-event "Bandage applied."
  say `elara "Wound cleaned and dressed. Watch for infection."
  say (patients/{key}/speaker) "That stings — but I already feel steadier."

fn apply-herbs key:
  pre:
    world/herbs > 0
    patients/{key}/condition = `feverish
  post:
    world/herbs = world/herbs@before - 1
    patients/{key}/health >= patients/{key}/health@before
  dec! world/herbs 1
  inc! patients/{key}/health 20
  set! patients/{key}/treated true
  when patients/{key}/health >= 70:
    set! patients/{key}/condition `recovering
  record-event "Herbs administered."
  say `elara "Drink this. It will draw out the fever."
  say (patients/{key}/speaker) "Bitter... but I feel a little better already."

fn discharge key:
  pre:
    patients/{key}/condition = `recovering or patients/{key}/condition = `stable
  post:
    patients/{key}/condition = `discharged
  set! patients/{key}/condition `discharged
  set! patients/{key}/treated true
  record-event "Patient discharged."
  say `elara "Safe travels. Return if the symptoms worsen."
  say (patients/{key}/speaker) "Thank you, healer. I won't forget this."

fn reset-treated:
  for k in (path-list patients):
    when patients/{k}/condition != `discharged:
      set! patients/{k}/treated false

fn condition-label cond:
  return match cond:
    `wounded:    "wounded"
    `feverish:   "feverish"
    `recovering: "recovering"
    `stable:     "stable"
    `discharged: "discharged"
    _:           "unknown"

# ── Scenes ───────────────────────────────────────────────────────────────────

scene start:
  The healer's ward — a long room filled with cots and the quiet sounds of the infirm.
  The HUD above shows your supplies and today's triage focus.

  * Enter the ward:
    init-ward
    record-event "Day 1 begins."
    -> ward

scene ward:
  say elara:
    Good morning, healer. Day {world/day} in the ward.

  [count-untreated > 0] {count-untreated} patient(s) still need attention today.
  [count-untreated = 0] All patients have been seen today.

  when patients/rook/health < 50 and not patients/rook/treated:
    say (patients/rook/speaker): Is the healer here? I need help.
  when patients/linden/health < 50 and not patients/linden/treated:
    say (patients/linden/speaker): Please — I can barely sit up.
  when patients/mira/health < 50 and not patients/mira/treated:
    say (patients/mira/speaker): Healer, my side aches.

  * [any-urgent?] Treat an urgent patient:
    set! world/triage-focus `urgent
    select-by-focus
    => treat-current
  * [any-dischargeable?] Discharge someone who has recovered:
    set! world/triage-focus `dischargeable
    select-by-focus
    => discharge-current
  * Pick by current focus ({world/triage-focus}):
    select-by-focus
    => treat-current
  * Rest until tomorrow:
    -> rest
  * [all-treated?] Close the ward for the day:
    -> ward-closed

scene treat-current:
  The selected patient lies here.

  say healer: Let me take a look at you.

  {patients/{world/selected-patient}/name} — condition: {condition-label (patients/{world/selected-patient}/condition)}, health {patients/{world/selected-patient}/health}/100.

  * [patients/{world/selected-patient}/condition = `wounded and world/bandages > 0] Apply bandages:
    apply-bandage world/selected-patient
    <-
  * [patients/{world/selected-patient}/condition = `feverish and world/herbs > 0] Administer herbs:
    apply-herbs world/selected-patient
    <-
  * Return to the ward:
    <-

scene discharge-current:
  A patient sits on the edge of their cot, ready to leave.

  say (patients/{world/selected-patient}/speaker): Am I free to go?

  * Discharge {patients/{world/selected-patient}/name}:
    discharge world/selected-patient
    <-
  * Keep them one more day:
    set! patients/{world/selected-patient}/treated true
    <-

scene rest:
  say elara: The ward grows quiet. {count-untreated} patient(s) remained unseen today.
  say healer: We do what we can.

  inc! world/day 1
  reset-treated
  record-event "A new day."
  -> ward

scene ward-closed:
  say elara:
    All patients seen. A good day's work.
    Rest now. Tomorrow brings more.

  The ward falls quiet as the last lamp is shuttered.

  * Begin a new day:
    inc! world/day 1
    reset-treated
    record-event "Ward reopens."
    -> ward

# ── Verification ─────────────────────────────────────────────────────────────

verify "discharged patients have positive health":
  from-any-state:
    all? (path-list patients) fn(k):
      not (patients/{k}/condition = `discharged) or patients/{k}/health > 0

verify "supplies never go negative":
  from-any-state:
    world/herbs >= 0 and world/bandages >= 0
