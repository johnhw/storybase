module demo15-spellwright
  version: 1.0

# Demo 15 — The Spellwright's Workshop
#
# Demonstrates:
#   • macro with-mana-cost: resource-guard with hygienic let binding
#     (the internal 'required' binding is renamed on each expansion,
#      so caller-side variables of the same name are never shadowed)
#   • macro craft-spell: ingredient-check + body splicing
#   • Both macros composed (nested body blocks)
#   • post: conditions with path@before on spell-casting functions
#   • Entity family 'spells' for the recipe registry
#   • verify block that exercises the macro-expanded code

engine-config:
  entry-scene: init

# ── Types ──────────────────────────────────────────────────────────────────────

type SpellKind     = fireball | ice-shard | heal-beam | binding-rune
type ComponentKind = dragonscale | frost-crystal | moonpetal | silkweb

"A spell recipe: ingredient, mana cost, and whether it has been successfully cast."
type SpellRecord:
  ingredient: ComponentKind = 'dragonscale
  mana-cost:  Int(0, 50)    = 20
  learned:    Bool          = false

# ── State ──────────────────────────────────────────────────────────────────────

state player/mana:        Int(0, 100) = 80
state player/health:      Int(0, 100) = 100
state player/components:  Set(ComponentKind, 10) = {'dragonscale, 'frost-crystal, 'moonpetal}
state player/description: String = ""

state world/spells-cast:  Int(0, 99) = 0
state world/initialized:  Bool       = false

"Spell recipe registry.  Keys are SpellKind symbols."
state spells/{spell}: SpellRecord  max: 8

# ── Macros ─────────────────────────────────────────────────────────────────────

# Guard a body with a mana cost.
# Hygiene note: the internal binding 'required' is renamed to a unique
# generated name (_mN_required) on every expansion, ensuring it can never
# shadow a caller-side variable that happens to be named 'required'.
macro with-mana-cost cost body:
  let required = cost:
    if player/mana >= required:
      dec! player/mana required
      body
    else:
      goto-scene! 'out-of-mana

# Consume one unit of an ingredient, then execute body; if missing, report it.
macro craft-spell ingredient body:
  if contains? player/components ingredient:
    remove! player/components ingredient
    body
  else:
    set! player/description "You lack the required component."

# ── Functions ──────────────────────────────────────────────────────────────────

fn init-workshop:
  when not world/initialized:
    set! world/initialized true
    spawn! spells 'fireball    SpellRecord(ingredient: 'dragonscale,  mana-cost: 20, learned: false)
    spawn! spells 'ice-shard   SpellRecord(ingredient: 'frost-crystal, mana-cost: 15, learned: false)
    spawn! spells 'heal-beam   SpellRecord(ingredient: 'moonpetal,     mana-cost: 25, learned: false)
    spawn! spells 'binding-rune SpellRecord(ingredient: 'silkweb,      mana-cost: 30, learned: false)

fn cast-fireball:
  pre:  player/mana > 0
  post: player/mana <= player/mana@before
  with-mana-cost cost: 20:
    craft-spell ingredient: 'dragonscale:
      set! spells/fireball/learned true
      inc! world/spells-cast 1
      set! player/description "A roaring fireball erupts from your outstretched hand!"

fn cast-ice-shard:
  pre:  player/mana > 0
  post: player/mana <= player/mana@before
  with-mana-cost cost: 15:
    craft-spell ingredient: 'frost-crystal:
      set! spells/ice-shard/learned true
      inc! world/spells-cast 1
      set! player/description "A lance of pure ice launches forward with a crack!"

fn cast-heal-beam:
  pre:  player/mana > 0
  post: player/mana <= player/mana@before
  with-mana-cost cost: 25:
    craft-spell ingredient: 'moonpetal:
      inc! player/health 30
      set! spells/heal-beam/learned true
      inc! world/spells-cast 1
      set! player/description "Warm golden light flows over your wounds and knits them closed."

fn gather-components:
  add! player/components 'dragonscale
  add! player/components 'frost-crystal
  add! player/components 'moonpetal
  add! player/components 'silkweb
  set! player/description "You've restocked your component pouches from the garden."

fn rest-and-recover:
  set! player/mana 80
  set! player/description "After a brief rest, your mana has fully recovered."

fn can-cast-fireball?:
  return player/mana >= 20 and contains? player/components 'dragonscale

fn can-cast-ice-shard?:
  return player/mana >= 15 and contains? player/components 'frost-crystal

fn can-cast-heal-beam?:
  return player/mana >= 25 and contains? player/components 'moonpetal

fn spells-mastered:
  return world/spells-cast

fn any-spell-castable?:
  return (can-cast-fireball?) or (can-cast-ice-shard?) or (can-cast-heal-beam?)

# ── Scenes ─────────────────────────────────────────────────────────────────────

scene init:
  Welcome to your workshop. Arcane diagrams cover every surface.

  * Enter the workshop
    init-workshop
    -> workshop

scene workshop:
  The Spellwright's Workshop.
  Mana: {player/mana}/100.  Components in pouch: {size player/components}.
  Spells cast this session: {world/spells-cast}.
  {player/description}

  * [can-cast-fireball?] Cast Fireball (20 mana + dragonscale)
    cast-fireball
    -> workshop
  * [can-cast-ice-shard?] Cast Ice Shard (15 mana + frost-crystal)
    cast-ice-shard
    -> workshop
  * [can-cast-heal-beam?] Cast Heal Beam (25 mana + moonpetal)
    cast-heal-beam
    -> workshop
  * Examine the spell shelf
    => examine-shelf
  * Gather components from the garden
    gather-components
    -> workshop
  * Rest and recover mana
    rest-and-recover
    -> workshop

scene examine-shelf:
  The carved spell shelf holds your learned formulae.
  Spells cast in total: {world/spells-cast}.

  [spells/fireball/learned]    Fireball    (dragonscale + 20 mana): mastered.
  [spells/ice-shard/learned]   Ice Shard   (frost-crystal + 15 mana): mastered.
  [spells/heal-beam/learned]   Heal Beam   (moonpetal + 25 mana): mastered.
  [spells/binding-rune/learned] Binding Rune (silkweb + 30 mana): mastered.

  * Return to the workshop
    <-

scene out-of-mana:
  Your mana is exhausted — the incantation fizzles before it can form.
  Mana remaining: {player/mana}/100.

  * Rest until mana recovers
    rest-and-recover
    -> workshop
  * Return to the workshop now
    -> workshop

# ── Verification ───────────────────────────────────────────────────────────────

verify "mana never drops below zero":
  from-any-state:
    player/mana >= 0

verify "health never exceeds 100":
  from-any-state:
    player/health <= 100

verify "can always recover mana from out-of-mana":
  when engine/current-scene = 'out-of-mana:
    can-reach? player/mana = 80  depth: 3
