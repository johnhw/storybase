module demo16-cartographers-web
  version: 1.0

# Demo 16 — The Cartographer's Web
#
# Demonstrates:
#   • or-where in find queries (trade hubs: markets OR coastal cities)
#   • connected-to via in find queries (cities reachable from capital)
#   • inverse-adjacent? (inbound roads to port-city)
#   • find with or-where + order-by + limit combined
#   • can-reach? with strategy: `depth-first
#   • find-path with strategy: `breadth-first and budget: N
#   • counterfactual simulate: true (route-bonus fires in counterfactual branch)
#   • relate!/unrelate! for dynamic road modifications
#   • Entity family cities/{city} with typed fields

engine-config:
  entry-scene: init
  max-counterfactual-depth: 3

time-model:
  axes: [turn]
  wrap: [none]

# ── Types ──────────────────────────────────────────────────────────────────────

type CityId      = capital-city | port-city | market-town | fortress | village
type Region      = northern | southern | eastern | western | central
type RouteStatus = closed | open | contested

"A city record: display name, population, trade flags, and controlling region."
type CityRecord:
  name:          String      = "Unknown"
  population:    Int(0, 100) = 10
  has-market:    Bool        = false
  coastal:       Bool        = false
  controlled-by: Region      = `northern

# ── State ──────────────────────────────────────────────────────────────────────

state player/gold:        Int(0, 9999) = 500
state player/location:    CityId       = `capital-city
state world/turn:         Int(0, 999)  = 0
state world/initialized:  Bool         = false
state world/route-status: RouteStatus  = `closed
state world/crisis-active: Bool        = false

"City records — keyed by CityId symbols, maximum 8 concurrent."
state cities/{city}: CityRecord  max: 8

# ── Relations ──────────────────────────────────────────────────────────────────

"Road network between cities (bidirectional adjacency)."
relation roads: CityId -> Set(CityId, 6):
  `capital-city: {`market-town, `fortress}
  `market-town:  {`capital-city, `port-city, `fortress}
  `port-city:    {`market-town, `village}
  `fortress:     {`capital-city, `market-town}
  `village:      {`port-city}

# ── Scheduling ─────────────────────────────────────────────────────────────────

"One-shot bonus at turn 0; fires in counterfactual simulate: true when route is open."
schedule route-bonus:
  at: [turn: 0]
  fn:
    when world/route-status = `open:
      inc! player/gold 50

"Prices fluctuate every 3 turns once a trade route is open."
schedule market-fluctuation:
  every: [turn: +3]
  fn:
    when world/route-status = `open:
      inc! player/gold 25

# ── Pure functions ─────────────────────────────────────────────────────────────

"All trade hubs: cities that have a market OR are coastal (or-where)."
fn trade-hubs:
  find cities
    where: cities/{cities}/has-market = true
    or-where: cities/{cities}/coastal = true

"Cities reachable from the capital via any road path (connected-to via)."
fn capital-connected-cities:
  find cities
    connected-to `capital-city via roads

"Top 3 accessible cities (coastal or market) ranked by population (or-where + order-by + limit)."
fn top-accessible:
  find cities
    where: cities/{cities}/coastal = true
    or-where: cities/{cities}/has-market = true
    order-by: cities/{cities}/population desc
    limit: 3

"Inbound road count to port-city (inverse-adjacent?)."
fn inbound-to-port-count:
  let inbound = (inverse-adjacent? roads `port-city)
  count inbound

"Can the player open a trade route? Verified via depth-first search."
fn route-reachable?:
  can-reach? (world/route-status = `open)  strategy: `depth-first  depth: 8

"Number of choice-steps on the shortest path to opening a route (find-path breadth-first)."
fn steps-to-open-route:
  let path = find-path (world/route-status = `open)  strategy: `breadth-first  depth: 10
  list-size (path ?? [])

"Preview gold if route were opened now — counterfactual simulate: true fires route-bonus."
fn preview-open-route:
  let alt = counterfactual simulate: true do:
    set! world/route-status `open
  (in-state alt) player/gold

"Count of trade hubs (markets or coastal cities)."
fn hub-count:
  find cities
    where: cities/{cities}/has-market = true
    or-where: cities/{cities}/coastal = true
    count

"Count of coastal cities."
fn coastal-count:
  find cities
    where: cities/{cities}/coastal = true
    count

# ── Transaction functions ──────────────────────────────────────────────────────

fn init-map:
  when not world/initialized:
    set! world/initialized true
    spawn! cities `capital-city CityRecord(name: "Crown's Reach",  population: 80, has-market: true,  coastal: false, controlled-by: `central)
    spawn! cities `market-town  CityRecord(name: "Trader's Rest",  population: 50, has-market: true,  coastal: false, controlled-by: `northern)
    spawn! cities `port-city    CityRecord(name: "Port Haven",     population: 40, has-market: false, coastal: true,  controlled-by: `eastern)
    spawn! cities `fortress     CityRecord(name: "Iron Keep",      population: 30, has-market: false, coastal: false, controlled-by: `western)
    spawn! cities `village      CityRecord(name: "Saltmarsh",      population: 15, has-market: false, coastal: true,  controlled-by: `eastern)

"Open a direct road between the fortress and the village."
fn open-village-road:
  pre:  world/route-status != `open
  post: world/route-status = `open
  relate!  roads `fortress `village
  relate!  roads `village  `fortress
  set!  world/route-status `open
  inc!  world/turn 1
  time-inc! turn: 1

"Sever Port Haven's main road (crisis event)."
fn trigger-crisis:
  pre:  not world/crisis-active
  post: world/crisis-active = true
  unrelate! roads `port-city  `market-town
  unrelate! roads `market-town `port-city
  set!  world/crisis-active true
  inc!  world/turn 1
  time-inc! turn: 1

fn advance-turn:
  inc!  world/turn 1
  time-inc! turn: 1

# ── Scenes ─────────────────────────────────────────────────────────────────────

scene init:
  Welcome to the Cartographer's Web.
  You oversee the kingdom's road network from Crown's Reach.

  * Begin mapping
    init-map
    -> map-room

scene map-room:
  The map room of Crown's Reach.
  Turn: {world/turn}.  Gold: {player/gold}.  Route: {world/route-status}.
  Trade hubs: {hub-count}.  Coastal cities: {coastal-count}.

  * Survey the region
    => survey-region
  * Plan a trade route
    => plan-route
  * Open the village road (fortress to village)
    => open-trade-route
  * [not world/crisis-active] Simulate a road crisis
    => crisis
  * Advance the clock
    advance-turn
    -> map-room

scene survey-region:
  You survey the kingdom's roads and accessible cities.
  Trade hubs (markets or coastal): {hub-count}.
  Cities connected to the capital: {list-size (capital-connected-cities)}.
  Inbound roads to Port Haven: {inbound-to-port-count}.

  * Find trade hubs (or-where: has-market or coastal)
    advance-turn
    -> survey-region
  * Rank top accessible cities (or-where + order-by + limit)
    advance-turn
    -> survey-region
  * Return to map room
    <-

scene plan-route:
  Route planning from {player/location}.
  Depth-first: can open a trade route? {route-reachable?}.
  Breadth-first steps to open trade route: {steps-to-open-route}.

  * Check route openability (can-reach? depth-first)
    advance-turn
    -> plan-route
  * Find path to open route (find-path breadth-first)
    advance-turn
    -> plan-route
  * Return to map room
    <-

scene open-trade-route:
  The fortress road leads north toward the village.
  Route status: {world/route-status}.
  Preview gold if route opens now: {preview-open-route}.

  * [world/route-status != `open] Open the fortress-village road
    open-village-road
    -> open-trade-route
  * Return to map room
    <-

scene crisis:
  Port Haven's coastal road has been disrupted.
  [world/crisis-active] Crisis active — port road severed.

  * Sever the port road (trigger-crisis)
    trigger-crisis
    -> crisis
  * [world/crisis-active] Assess impact and advance time
    advance-turn
    -> crisis
  * Return to map room
    <-

# ── Verification ───────────────────────────────────────────────────────────────

verify "there are always at least two trade hubs (market or coastal)":
  when world/initialized:
  from-any-state:
    hub-count >= 2

verify "opening the village road sets route status to open":
  requires world/route-status != `open
  after (open-village-road):
    world/route-status = `open

verify "gold is always non-negative":
  from-any-state:
    player/gold >= 0
