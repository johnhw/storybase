# demo06_buried_keep.sb
# The Buried Keep — recover the Sunstone before the torches burn out.
#
# Features demonstrated:
#   schema-version + migration 1->2
#   record types (PartyMember)
#   relation (static room-exits, dynamic room-loot / room-monster)
#   relate! / unrelate!
#   defgrid (keep-layout 6x6, within-range?)
#   tag + hook (tag combat; hook combat: post:; hook after: move-to:)
#   watch / watch-when
#   random-bool, random-enum, random-weighted
#   str, abs, clamp
#   size, empty? on relations
#   union / intersect on sets
#   list-get / list-size on a spell list
#   any? / all? with lambdas
#   push! / pop! on spell list
#   engine/tick
#   time-model
#   schedule (torch-burn, wraith-stirs) + cancel-schedule!
#   actor + send! + inbox (scout-npc)
#   match on variant message
#   spawn! / despawn! (entity family)
#   count-where, for loop over path-list
#   path-exists?
#   verify-always invariants
#   in binary operator (membership test)
#   8 named scenes
#   doc strings on all declarations
#
# Run with:  storybase run demos/demo06_buried_keep.sb
# Auto run:  storybase run --auto --steps 6 demos/demo06_buried_keep.sb

module buried-keep
  version: 2

schema-version: 2

migration 1 -> 2:
  add world/kills = 0

engine-config:
  entry-scene: intro

time-model:
  axes: [turn]
  wrap: [none]

# ─────────────────────────────────────────────────────────
# Types
# ─────────────────────────────────────────────────────────

"Rooms in the Buried Keep."
type Room = entrance | corridor | armory | vault | throne-room

"Adventurer roles."
type Role = warrior | mage | scout

"Party member status."
type Status = active | wounded | dead

"Monsters lurking in the keep."
type MonsterKind = skeleton | wraith | golem

"Items that can be found in the keep."
type ItemKind = sunstone | iron-sword | kite-shield | torch-bundle | healing-draught

"Tile kinds for the keep layout grid."
type TileKind = open | wall | pit

"Spells available to the mage."
type SpellKind = fireball | shield | reveal

"A party member with role, hit points, and status."
type PartyMember:
  role:   Role
  hp:     Int(0, 20)
  status: Status

"Messages the scout NPC sends to the party."
type ScoutMsg:
  | warn-ambush: room: Room
  | found-exit:

# ─────────────────────────────────────────────────────────
# State
# ─────────────────────────────────────────────────────────

"World state: current room, turn counter, resources."
state world:
  current-room:   Room       = `entrance
  turn:           Int(0, 30) = 0
  sunstone-found: Bool       = false
  escaped:        Bool       = false
  torches:        Int(0, 10) = 5
  kills:          Int(0, 30) = 0

"The three adventurers. Spawned at game start."
state party/{name}: PartyMember  max: 4

"Inventory: collected items."
state inventory: Set(ItemKind, 8) = (set)

"Mage's active spell list — demonstrates push!/pop!/list-get."
state sylva/spells: List(SpellKind, 4) = (list)

# ─────────────────────────────────────────────────────────
# Relations
# ─────────────────────────────────────────────────────────

"Movement graph between keep rooms."
relation room-exits: Room -> Set(Room, 3):
  `entrance:    {`corridor}
  `corridor:    {`entrance, `armory, `vault}
  `armory:      {`corridor, `throne-room}
  `vault:       {`corridor}
  `throne-room: {`armory}

"Items available in each room. Cleared when looted."
relation room-loot: Room -> Set(ItemKind, 4):
  `armory: {`iron-sword, `kite-shield}
  `vault:  {`sunstone, `healing-draught, `torch-bundle}

"Monsters present in each room. Cleared when defeated."
relation room-monster: Room -> Set(MonsterKind, 2):
  `corridor:    {`skeleton}
  `armory:      {`wraith}
  `throne-room: {`golem}

# ─────────────────────────────────────────────────────────
# Grid layout
# ─────────────────────────────────────────────────────────

"6x6 overhead layout of the Buried Keep."
defgrid keep-layout:
  dimensions: 6 x 6
  cell-type:  TileKind
  default:    open

# ─────────────────────────────────────────────────────────
# Actor
# ─────────────────────────────────────────────────────────

"Scout companion — warns of nearby threats and exit visibility."
actor scout-npc:
  perceives: [world/current-room, world/torches]
  inbox:     List(ScoutMsg, 4)
  behavior:  scout-behavior
  priority:  5

# ─────────────────────────────────────────────────────────
# Tags and Hooks
# ─────────────────────────────────────────────────────────

"Marks functions that involve combat."
tag combat

"Marks functions that involve exploration and movement."
tag explore

"After any combat function, check changes for kills and warn scout if wounded."
hook combat:
  post:
    for c in changes:
      when c/path = "world/kills" and c/new > (c/old ?? 0):
        pass  # kill was recorded inside the fn; hook detects it
    when any-wounded?:
      send! scout-npc (ScoutMsg/warn-ambush room: world/current-room)

"After every move, burn one torch."
hook after: move-to:
  when world/torches > 0:
    dec! world/torches 1

# ─────────────────────────────────────────────────────────
# Watch declarations
# ─────────────────────────────────────────────────────────

watch world/turn      "Turn"
watch world/torches   "Torches"
watch world/kills     "Kills"
watch-when all-party-dead?           "All party members dead!"
watch-when world/sunstone-found      "Sunstone recovered!"
watch-when world/torches = 0         "Torches exhausted!"

# ─────────────────────────────────────────────────────────
# Schedules
# ─────────────────────────────────────────────────────────

"Torches burn down over time — one torch every 3 turns."
schedule torch-burn:
  every:  [turn: +3]
  offset: [turn: 0]
  fn:
    when world/torches > 0:
      dec! world/torches 1

"A wraith stirs in the keep every 5 turns."
schedule wraith-stirs:
  every:  [turn: +5]
  offset: [turn: 2]
  fn:
    when not (`wraith in (adjacent? room-monster world/current-room)):
      relate! room-monster world/current-room `wraith
      send! scout-npc (ScoutMsg/warn-ambush room: world/current-room)

# ─────────────────────────────────────────────────────────
# Verify blocks
# ─────────────────────────────────────────────────────────

verify "torch count never negative":
  verify-always world/torches >= 0

verify "kill counter never negative":
  verify-always world/kills >= 0

verify "escaped requires sunstone found":
  verify-always not world/escaped or world/sunstone-found

# ─────────────────────────────────────────────────────────
# Pure functions
# ─────────────────────────────────────────────────────────

"Count party members still alive."
fn living-count:
  count-where (path-list party) fn(m): party/{m}/status != `dead

"True if all party members are dead."
fn all-party-dead?:
  living-count = 0

"True if any party member is wounded."
fn any-wounded?:
  any? (path-list party) fn(m): party/{m}/status = `wounded

"True if all party members are in active status."
fn all-healthy?:
  all? (path-list party) fn(m): party/{m}/status = `active

"True if the given item is in the party inventory."
fn has-item? kind:
  kind in inventory

"Number of monsters in the current room."
fn monster-count:
  size (adjacent? room-monster world/current-room)

"True if current room has no monsters."
fn room-clear?:
  empty? (adjacent? room-monster world/current-room)

"True if the party has the Sunstone and is at the entrance."
fn can-escape?:
  world/sunstone-found and world/current-room = `entrance

"True if torches are critically low."
fn torches-critical?:
  world/torches <= 1

"Base damage from a monster type."
fn damage-from kind:
  match kind:
    `skeleton: 3
    `wraith:   5
    `golem:    8
    _: 2

"Number of spells the mage has prepared."
fn spell-count:
  list-size sylva/spells

"Get the mage's first prepared spell."
fn first-spell:
  list-get sylva/spells 1

# ─────────────────────────────────────────────────────────
# Transaction functions
# ─────────────────────────────────────────────────────────

"Set up the keep grid with walls and pits."
fn init-grid:
  grid-set! keep-layout 0 0 `wall
  grid-set! keep-layout 1 0 `wall
  grid-set! keep-layout 5 5 `pit
  grid-set! keep-layout 4 5 `pit
  grid-set! keep-layout 0 5 `wall

"Spawn the starting party."
fn spawn-party:
  spawn! party `aldric  PartyMember(role: `warrior, hp: 20, status: `active)
  spawn! party `sylva   PartyMember(role: `mage,    hp: 15, status: `active)
  spawn! party `pin     PartyMember(role: `scout,   hp: 18, status: `active)
  push! sylva/spells `fireball
  push! sylva/spells `shield

"Move to an adjacent room."
fn move-to room:
  tags: [explore]
  pre: room in (adjacent? room-exits world/current-room)
  pre: not all-party-dead?
  pre: world/torches > 0
  set! world/current-room room
  time-inc! turn: 1
  inc! world/turn 1
  when random-bool 0.3:
    when not room-clear?:
      let extra = random-enum MonsterKind
      when not (extra in (adjacent? room-monster room)):
        relate! room-monster room extra

"Attack a monster in the current room. Deals damage and may wound party members."
fn attack-monster kind:
  tags: [combat]
  pre: kind in (adjacent? room-monster world/current-room)
  let base-dmg = damage-from kind
  let roll     = random-int 1 4
  let dmg      = clamp (base-dmg + roll - 2) 1 12
  for m in (path-list party):
    when party/{m}/status = `active:
      let taken = clamp (dmg - abs (dmg - 3)) 0 8
      dec! party/{m}/hp taken
      when party/{m}/hp = 0:
        set! party/{m}/status `dead
        despawn! party m
      when party/{m}/hp > 0 and party/{m}/hp < 8:
        set! party/{m}/status `wounded
  unrelate! room-monster world/current-room kind
  inc! world/kills 1

"Cast the mage's first prepared spell — pops it from the list."
fn cast-spell:
  pre: path-exists? party/sylva
  pre: spell-count > 0
  pre: not room-clear?
  pop! sylva/spells
  for m in (path-list party):
    when party/{m}/status = `wounded:
      set! party/{m}/status `active
      set! party/{m}/hp 12

"Pick up an item from the current room."
fn pick-up item:
  pre: item in (adjacent? room-loot world/current-room)
  pre: not (item in inventory)
  add! inventory item
  unrelate! room-loot world/current-room item
  when item = `sunstone:
    set! world/sunstone-found true
  when item = `torch-bundle:
    inc! world/torches 3

"Drink a healing draught to restore a wounded member."
fn use-healing-draught:
  pre: has-item? `healing-draught
  pre: any-wounded?
  remove! inventory `healing-draught
  for m in (path-list party):
    when party/{m}/status = `wounded:
      set! party/{m}/status `active
      set! party/{m}/hp 15

"Escape the keep with the Sunstone."
fn escape:
  pre: can-escape?
  set! world/escaped true
  cancel-schedule! torch-burn
  cancel-schedule! wraith-stirs

"Scout behavior: process inbox messages."
fn scout-behavior:
  for msg in scout-npc/inbox:
    match msg:
      warn-ambush {room}:
        pass  # Scout notes the warning
      found-exit:
        pass

# ─────────────────────────────────────────────────────────
# Scenes
# ─────────────────────────────────────────────────────────

scene intro:
  THE BURIED KEEP
  A subterranean fortress concealing a relic of terrible power — the Sunstone.
  Your party of three has descended into its depths. Find the Sunstone and
  escape before the torches burn out.

  Engine tick: {engine/tick}. Your quest begins now.

  * Begin the descent
    init-grid
    spawn-party
    -> keep

scene keep:
  Room: {world/current-room}. Turn {world/turn}/30.
  Torches: {world/torches}. Kills: {world/kills}.
  Adventurers alive: {living-count}.
  Spells prepared: {spell-count}.

  when torches-critical?:
    WARNING: The torches are almost out. Hurry.

  when not room-clear?:
    Shadows move. Monsters lurk here.
  when room-clear?:
    The room is clear.

  when any-wounded?:
    Some party members are wounded and need healing.

  when world/sunstone-found:
    The Sunstone pulses in the inventory, warm and urgent.
    Get back to the entrance to escape.

  when within-range? keep-layout 2 2 4 4 range: 3:
    The keep's central passages are within reach.

  when all-party-dead?:
    -> defeat

  when world/torches = 0 and not world/escaped:
    -> defeat

  * [`entrance in (adjacent? room-exits world/current-room)] Move to entrance
    move-to `entrance
    -> keep

  * [`corridor in (adjacent? room-exits world/current-room)] Move to corridor
    move-to `corridor
    -> keep

  * [`armory in (adjacent? room-exits world/current-room)] Move to armory
    move-to `armory
    -> keep

  * [`vault in (adjacent? room-exits world/current-room)] Move to vault
    move-to `vault
    -> keep

  * [`throne-room in (adjacent? room-exits world/current-room)] Move to throne room
    move-to `throne-room
    -> keep

  * [not room-clear?] Fight a monster
    -> combat

  * [not (empty? (adjacent? room-loot world/current-room))] Examine loot
    -> loot-room

  * [has-item? `healing-draught and any-wounded?] Use healing draught
    use-healing-draught
    -> keep

  * [path-exists? party/sylva and spell-count > 0 and not room-clear?] Cast spell (mage)
    cast-spell
    -> keep

  * [can-escape?] ESCAPE with the Sunstone
    escape
    -> victory

scene combat:
  Battle in the {world/current-room}.
  Monsters here: {monster-count}.

  when `skeleton in (adjacent? room-monster world/current-room):
    Skeletons rattle — they deal moderate damage.
  when `wraith in (adjacent? room-monster world/current-room):
    A wraith glides through the air — it drains life force.
  when `golem in (adjacent? room-monster world/current-room):
    A massive stone golem guards the passage.

  * [`skeleton in (adjacent? room-monster world/current-room)] Attack the skeleton
    attack-monster `skeleton
    -> keep

  * [`wraith in (adjacent? room-monster world/current-room)] Attack the wraith
    attack-monster `wraith
    -> keep

  * [`golem in (adjacent? room-monster world/current-room)] Attack the golem
    attack-monster `golem
    -> keep

  * Retreat (return to entrance if possible)
    -> keep

scene loot-room:
  You search the {world/current-room}.
  Items found here.

  * [`sunstone in (adjacent? room-loot world/current-room)] Take the Sunstone (KEY ITEM)
    pick-up `sunstone
    -> keep

  * [`iron-sword in (adjacent? room-loot world/current-room)] Take the iron sword
    pick-up `iron-sword
    -> keep

  * [`kite-shield in (adjacent? room-loot world/current-room)] Take the kite shield
    pick-up `kite-shield
    -> keep

  * [`healing-draught in (adjacent? room-loot world/current-room)] Take the healing draught
    pick-up `healing-draught
    -> keep

  * [`torch-bundle in (adjacent? room-loot world/current-room)] Take the torch bundle
    pick-up `torch-bundle
    -> keep

  * Leave the room
    -> keep

scene victory:
  VICTORY.
  The party escapes the Buried Keep carrying the Sunstone.

  Turn {world/turn} reached. Kills: {world/kills}.
  Survivors: {living-count} of 3.

  if living-count >= 3:
    A perfect delve — all three adventurers survived.
  else:
    if living-count >= 2:
      A costly victory — two survivors made it out.
    else:
      A desperate escape — only one survivor remains.

  The Sunstone is safe. The keep falls silent.

scene defeat:
  DEFEAT.

  if world/torches = 0:
    Darkness descends. The torches have burned out.
    Without light, the party cannot find the exit.
    The keep claims another set of souls.
  else:
    The party has fallen. No one remains to carry the Sunstone.

  Reached turn {world/turn}. Kills recorded: {world/kills}.
