# demo27_grimoire.sb
# "The Apprentice's Grimoire" — three spell systems generated by a single
# file-local `decl-macro`. No `@stdlib/` import: this demo is the missing
# user-authored macro example to complement demos 24/25 (which import
# their macros from the bundled standard library).
#
# Demonstrates features no earlier demo exercises end-to-end:
#
#   1. A file-local `decl-macro spell` with positional params per §E0:
#         decl-macro spell $name $cost $power $max:
#      Each call expands a full spell subsystem (state + fns + verify).
#      (Positional only per the parser; the column header at the call
#       sites is just for readability.)
#
#   2. `$param` substitution in the slot kinds documented in language.md §E0:
#        - composite single-segment name parts:
#               state spell-$name-learned, fn cast-$name, fn $name-power
#        - integer-bound slot:  Int(0, $max)
#        - whole-expression literal: $power (fn body),
#               dec! player/mana $cost, spell-$name-uses < $max
#
#   3. A per-spell `verify-eventually` baked into the macro: `storybase
#      verify` proves every spell is castable from the initial state, with
#      no hand-written verify block at the call sites.
#
# Adding a fourth spell is one line at the bottom; the matching state,
# functions, and verify block all materialise from that line alone (only
# the per-spell scene choice has to be added by hand, since scene choice
# lists aren't yet emittable from inside a decl-macro body).
#
# Run with:   storybase run demos/demo27_grimoire.sb
# Verify:     storybase verify demos/demo27_grimoire.sb

module grimoire
  version: 1.0

engine-config:
  entry-scene: chamber

# ── Shared world state ───────────────────────────────────────────────

state player:
  mana:        Int(0, 100) = 60
  meditations: Int(0, 50)  = 0

state world:
  total-casts: Int(0, 99) = 0

# ── The spell decl-macro ─────────────────────────────────────────────
#
# Positional params per the §E0 convention:
#   $name   — bare segment used in single-segment composite names
#   $cost   — int literal threaded through preconditions and `dec!`
#   $power  — int literal returned by the $name-power query
#   $max    — int literal in BOTH the Int(0, $max) bound slot and the
#             precondition / verify-eventually expressions
#
# State paths are kept single-segment (spell-$name-learned,
# spell-$name-uses) so that read-side expressions inside the macro body
# can reference them via COMPOSITE_IDENT → path_expr substitution; the
# scene below then reads them through the per-spell `$name-uses` and
# `$name-learned?` accessor fns that this macro also emits.

decl-macro spell $name $cost $power $max:
  state spell-$name-learned: Bool         = false
  state spell-$name-uses:    Int(0, $max) = 0

  fn $name-power:
    $power

  fn $name-uses:
    spell-$name-uses

  fn $name-learned?:
    spell-$name-learned

  fn $name-exhausted?:
    spell-$name-uses >= $max

  fn cast-$name:
    pre: player/mana >= $cost
    pre: not ($name-exhausted?)
    dec! player/mana $cost
    inc! spell-$name-uses 1
    set! spell-$name-learned true
    inc! world/total-casts 1

  fn cast-$name-once?:
    spell-$name-uses > 0

  verify "spell is reachable from initial state":
    verify-eventually (cast-$name-once?)

# ── Three spells from three single-line calls ────────────────────────
#
#       name      cost  power  max
spell  fireball    20    8      5
spell  mend        15    6      8
spell  ward        10    4      3

# ── A non-spell fn for mana recovery ─────────────────────────────────

fn meditate:
  set! player/mana 60
  inc! player/meditations 1

# ── Scenes ───────────────────────────────────────────────────────────

scene chamber:
  The grimoire lies open on the lectern.
  Mana {player/mana}/100.  Total casts {world/total-casts}.  Meditations {player/meditations}.
  Fireball : uses {fireball-uses}/5  power {fireball-power}
  Mend     : uses {mend-uses}/8      power {mend-power}
  Ward     : uses {ward-uses}/3      power {ward-power}

  * [player/mana >= 20 and not (fireball-exhausted?)] Cast Fireball (20 mana)
    cast-fireball
    -> chamber

  * [player/mana >= 15 and not (mend-exhausted?)] Cast Mend (15 mana)
    cast-mend
    -> chamber

  * [player/mana >= 10 and not (ward-exhausted?)] Cast Ward (10 mana)
    cast-ward
    -> chamber

  * [player/mana < 20] Meditate to restore mana
    meditate
    -> chamber

  * [world/total-casts >= 3] Close the grimoire for today
    -> rest

scene rest:
  The grimoire is closed.
  Three spells in the journal — fireball cast {fireball-uses}, mend cast {mend-uses}, ward cast {ward-uses}.
  Total mana spent across {world/total-casts} casts.
